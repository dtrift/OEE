  <diagram name="Страница-1" id="2MVv5JhMyf1IUHG5CViG">
    <mxGraphModel dx="2107" dy="1520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\&quot;theme\&quot;: \&quot;neutral\&quot;, \&quot;flowchart\&quot;: {\&quot;htmlLabels\&quot;: false, \&quot;curve\&quot;: \&quot;linear\&quot;, \&quot;nodeSpacing\&quot;: 46, \&quot;rankSpacing\&quot;: 64, \&quot;padding\&quot;: 12}, \&quot;themeVariables\&quot;: {\&quot;fontSize\&quot;: \&quot;13px\&quot;}}}%%\nflowchart LR\n\n  HOST[\&quot;PC1 · хост-ПК&lt;br/&gt;прошивка · питание · лог UART&lt;br/&gt;USB-C data-кабели ×3\&quot;]\n  UA[\&quot;U1 · Узел A · DevKitC-1 №1&lt;br/&gt;ток двигателя · только ADC1&lt;br/&gt;(GPIO1–10, ADC2 занят WiFi)\&quot;]\n  UQ[\&quot;U2 · Узел Q · DevKitC-1 №2&lt;br/&gt;I2S (любые пины) + PWM серво\&quot;]\n  UP[\&quot;U3 · Узел P · WROOM-1 N16R8 CAM&lt;br/&gt;счёт деталей · OV2640 (stretch)&lt;br/&gt;только пины, свободные от камеры\&quot;]\n\n  XS1[\&quot;XS1 · ACS712-20A&lt;br/&gt;лежит РЯДОМ с BB1 (широкие клеммы)&lt;br/&gt;стартовая калибровка нуля (станок выключен)\&quot;]\n  M2[\&quot;M2 · SG90 + палочка 15 см&lt;br/&gt;короткий удар по остановленной детали\&quot;]\n\n  BT1[\&quot;BT1 · БП 5 В 2 А&lt;br/&gt;только серво!\&quot;]\n  BT2[\&quot;BT2 · БП 12 В&lt;br/&gt;цепь станка ≤ 36 В — никогда 220 В!\&quot;]\n\n  GND((\&quot;GND · общий&lt;br/&gt;минусовые шины всех 3 макеток соединены&lt;br/&gt;минус каждого узла и каждого БП\&quot;))\n  P3((\&quot;+3 В&lt;br/&gt;верхние + шины BB2 + BB3&lt;br/&gt;с 3V3 платы U2\&quot;))\n  P5A((\&quot;+5 В (A)&lt;br/&gt;нижняя + шина BB1&lt;br/&gt;только VCC ACS712\&quot;))\n  P5S((\&quot;+5 В (СЕРВО)&lt;br/&gt;от BT1 · только BB2&lt;br/&gt;никогда не соединять с +5 В (A)!\&quot;))\n\n  subgraph BB1 [\&quot;MB-102 №1 · BB1 · стенд узла A — делитель тока · U1 и XS1 рядом (M-F перемычки)\&quot;]\n    direction TB\n    R1[\&quot;R1 · 10 кОм · BB1 стр. 1\&quot;]\n    TAP((\&quot;отвод&lt;br/&gt;BB1 стр. 2\&quot;))\n    R2[\&quot;R2 · 10 кОм · BB1 стр. 3\&quot;]\n  end\n\n  subgraph BB2 [\&quot;MB-102 №2 · BB2 · стенд узла Q — I2S микрофон + колодка серво · U2 рядом (M-F перемычки)\&quot;]\n    direction TB\n    Z1[\&quot;BB2 строки 1–5 · XS2 INMP441 (I2S микрофон)&lt;br/&gt;модуль у точки удара, 2–5 см, мембраной к удару&lt;br/&gt;перемычки ≤ 15 см · пины VDD GND SD SCK WS L/R\&quot;]\n    Z2[\&quot;BB2 строки 8–12 · колодка серво&lt;br/&gt;провода SG90 заходят сюда · 470 мкФ между +5 В и GND&lt;br/&gt;длинная ножка = + (строка 8) · сначала стабильные 5 В\&quot;]\n  end\n\n  subgraph BB3 [\&quot;MB-102 №3 · BB3 · стенд узла P — ИК-счётчик · U3 рядом (M-F перемычки)\&quot;]\n    direction TB\n    Z4[\&quot;BB3 строки 1–3 · XS4 TCRT5000 №1 (ИК-счётчик)&lt;br/&gt;луч через зазор сброса, 2–10 мм&lt;br/&gt;настройка по светодиодам · пины VCC GND OUT\&quot;]\n  end\n\n  subgraph MECH [\&quot;МЕХАНИКА — без электрической связи с узлами\&quot;]\n    M1[\&quot;M1 · СТАНОК&lt;br/&gt;вентилятор/дрель + болт на лопасти (нагрузка)\&quot;]\n    CONV[\&quot;КОНВЕЙЕР 100×350 мм&lt;br/&gt;свой мотор-редуктор + регулятор скорости + свой адаптер&lt;br/&gt;НЕ мониторится\&quot;]\n  end\n\n  subgraph OPT [\&quot;ОПЦИИ — не в базовой разводке\&quot;]\n    XS5[\&quot;XS5 · TCRT5000 №2&lt;br/&gt;датчик конца ленты (опция)\&quot;]\n    INA[\&quot;INA226 (опция I2C)&lt;br/&gt;делитель не нужен · не подключён\&quot;]\n  end\n\n  CHK[\&quot;ЧЕК-ЛИСТ ПЕРЕД ПОДАЧЕЙ ПИТАНИЯ&lt;br/&gt;USB-кабели передают данные (charge-only не прошьёт)&lt;br/&gt;стабильные 5 В на строках 8/10 BB2 до подключения серво&lt;br/&gt;межплатные перемычки: GND на всех 3 макетках · +3 В BB2→BB3&lt;br/&gt;отвод делителя ≈ 1,2–1,3 В (станок выключен)&lt;br/&gt;светодиоды TCRT: тишина на пустой ленте, вспышка на деталь&lt;br/&gt;занятые GPIO: 0/3/45/46 · 19/20 · 35–37 · 43/44\&quot;]\n\n  HOST -. \&quot;USB-C №1 (данные)\&quot; .-&gt; UA\n  HOST -. \&quot;USB-C №2\&quot; .-&gt; UQ\n  HOST -. \&quot;USB-C №3\&quot; .-&gt; UP\n\n  BT2 == \&quot;+12 В → IP+\&quot; ==&gt; XS1\n  XS1 == \&quot;IP− → M+\&quot; ==&gt; M1\n  M1 -. \&quot;− возврат\&quot; .-&gt; BT2\n\n  UA -- \&quot;пин 5V\&quot; --&gt; P5A\n  P5A -- \&quot;VCC ← нижняя + шина BB1\&quot; --&gt; XS1\n  UQ -- \&quot;3V3\&quot; --&gt; P3\n  P3 -- \&quot;верхняя + шина BB2 → VDD стр. 1\&quot; --&gt; Z1\n  P3 -- \&quot;мост BB2→BB3 → VCC стр. 1\&quot; --&gt; Z4\n  BT1 -- \&quot;+\&quot; --&gt; P5S\n  P5S -- \&quot;красный → BB2 стр. 8\&quot; --&gt; Z2\n\n  UQ -- \&quot;SCK = GPIO12 → BB2 стр. 4\&quot; --&gt; Z1\n  UQ -- \&quot;WS = GPIO13 → BB2 стр. 5\&quot; --&gt; Z1\n  UQ -- \&quot;SD = GPIO14 → BB2 стр. 3\&quot; --&gt; Z1\n  UQ -- \&quot;PWM 50 Гц · GPIO11 → BB2 стр. 12\&quot; --&gt; Z2\n  Z2 -- \&quot;SIG (оранжевый)\&quot; --&gt; M2\n  M2 -- \&quot;коричневый − → BB2 стр. 10\&quot; --&gt; Z2\n\n  BT1 -- \&quot;− → общий GND!\&quot; --&gt; GND\n  Z2 -- \&quot;GND BB2 стр. 10 → − шина\&quot; --&gt; GND\n  Z1 -- \&quot;GND BB2 стр. 2 · L/R→GND\&quot; --&gt; GND\n\n  XS1 -- \&quot;OUT (белый) → BB1 стр. 1\&quot; --&gt; R1\n  R1 -- \&quot;BB1 стр. 2\&quot; --&gt; TAP\n  TAP -- \&quot;отвод → GPIO4 (ADC1)\&quot; --&gt; UA\n  TAP -- \&quot;→ BB1 стр. 3\&quot; --&gt; R2\n  R2 -- \&quot;BB1 стр. 3 → − шина\&quot; --&gt; GND\n\n  Z4 -- \&quot;OUT BB3 стр. 3 → GPIO5\&quot; --&gt; UP\n  Z4 -- \&quot;GND BB3 стр. 2\&quot; --&gt; GND\n  UP --&gt; GND\n  UA --&gt; GND\n  UQ --&gt; GND\n\n  XS5 -. \&quot;OUT → ещё один свободный пин\&quot; .-&gt; UP\n  M1 -. \&quot;начало ленты · дисбаланс болта\&quot; .- CONV\n  INA -. \&quot;I2C — пока не подключён\&quot; .- XS1\n\n  classDef board fill:#e2e8f0,stroke:#475569,stroke-width:2px,color:#1f2937\n  classDef sensor fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a\n  classDef power fill:#f1f5f9,stroke:#64748b,stroke-width:2px,color:#1f2937\n  classDef res fill:#ffffff,stroke:#16a34a,stroke-width:2px,color:#14532d\n  classDef net fill:#ffffff,stroke:#111827,stroke-width:1.6px,color:#111827\n  classDef zone fill:#fefce8,stroke:#ca8a04,stroke-width:1.8px,color:#713f12\n  classDef mech fill:#f8fafc,stroke:#57534e,stroke-width:1.6px,stroke-dasharray:6 4,color:#57534e\n  classDef opt fill:#f8fafc,stroke:#94a3b8,stroke-width:1.4px,stroke-dasharray:4 3,color:#475569\n  classDef note fill:#f1f5f9,stroke:#64748b,stroke-width:1.4px,color:#334155\n\n  class HOST,UA,UQ,UP board\n  class XS1,M2 sensor\n  class BT1,BT2 power\n  class R1,R2 res\n  class GND,P3,P5A,P5S,TAP net\n  class Z1,Z2,Z4 zone\n  class M1,CONV mech\n  class XS5,INA opt\n  class CHK note&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pHWhnGjTSyzdKf-VjEO7-2">
