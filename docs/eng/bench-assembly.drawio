        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\&quot;theme\&quot;: \&quot;neutral\&quot;, \&quot;flowchart\&quot;: {\&quot;htmlLabels\&quot;: false, \&quot;curve\&quot;: \&quot;linear\&quot;, \&quot;nodeSpacing\&quot;: 46, \&quot;rankSpacing\&quot;: 64, \&quot;padding\&quot;: 12}, \&quot;themeVariables\&quot;: {\&quot;fontSize\&quot;: \&quot;13px\&quot;}}}%%\nflowchart LR\n\n  HOST[\&quot;PC1 · HOST PC&lt;br/&gt;flashing · power · UART log&lt;br/&gt;USB-C data cables ×3\&quot;]\n  UA[\&quot;U1 · NODE A · DevKitC-1 #1&lt;br/&gt;drive current · ADC1 only&lt;br/&gt;(GPIO1–10, ADC2 is lost to WiFi)\&quot;]\n  UQ[\&quot;U2 · NODE Q · DevKitC-1 #2&lt;br/&gt;I2S (any pins) + servo PWM\&quot;]\n  UP[\&quot;U3 · NODE P · WROOM-1 N16R8 CAM&lt;br/&gt;part counting · OV2640 (stretch)&lt;br/&gt;camera-free pins only\&quot;]\n\n  XS1[\&quot;XS1 · ACS712-20A&lt;br/&gt;lies NEXT to BB1 (wide terminals)&lt;br/&gt;startup zero recal (machine off)\&quot;]\n  M2[\&quot;M2 · SG90 + 15 cm stick&lt;br/&gt;short stroke onto the stopped part\&quot;]\n\n  BT1[\&quot;BT1 · 5 V 2 A PSU&lt;br/&gt;servo only!\&quot;]\n  BT2[\&quot;BT2 · 12 V PSU&lt;br/&gt;machine line ≤ 36 V — never 220 V!\&quot;]\n\n  GND((\&quot;GND · common&lt;br/&gt;− rails of all 3 BBs bridged&lt;br/&gt;every node + every PSU −\&quot;))\n  P3((\&quot;+3 V&lt;br/&gt;top + rails BB2 + BB3&lt;br/&gt;from U2 3V3\&quot;))\n  P5A((\&quot;+5 V (A)&lt;br/&gt;BB1 bottom + rail&lt;br/&gt;ACS712 VCC only\&quot;))\n  P5S((\&quot;+5 V (SERVO)&lt;br/&gt;from BT1 · BB2 only&lt;br/&gt;never tied to +5 V (A)!\&quot;))\n\n  subgraph BB1 [\&quot;MB-102 #1 · BB1 · NODE A bench — current divider · U1 &amp; XS1 lie next to it (M-F jumpers)\&quot;]\n    direction TB\n    R1[\&quot;R1 · 10 kΩ · BB1 r1\&quot;]\n    TAP((\&quot;tap&lt;br/&gt;BB1 r2\&quot;))\n    R2[\&quot;R2 · 10 kΩ · BB1 r3\&quot;]\n  end\n\n  subgraph BB2 [\&quot;MB-102 #2 · BB2 · NODE Q bench — I2S mic + servo header · U2 lies next to it (M-F jumpers)\&quot;]\n    direction TB\n    Z1[\&quot;BB2 rows 1–5 · XS2 INMP441 (I2S mic)&lt;br/&gt;module at the tap point, 2–5 cm, membrane to the strike&lt;br/&gt;jumpers ≤ 15 cm · pins VDD GND SD SCK WS L/R\&quot;]\n    Z2[\&quot;BB2 rows 8–12 · servo header&lt;br/&gt;SG90 wires land here · 470 µF across +5 V / GND&lt;br/&gt;long leg = + (row 8) · check a steady 5 V first\&quot;]\n  end\n\n  subgraph BB3 [\&quot;MB-102 #3 · BB3 · NODE P bench — IR counter · U3 lies next to it (M-F jumpers)\&quot;]\n    direction TB\n    Z4[\&quot;BB3 rows 1–3 · XS4 TCRT5000 #1 (IR counter)&lt;br/&gt;beam across the drop-off gap, 2–10 mm&lt;br/&gt;trim by the LEDs · pins VCC GND OUT\&quot;]\n  end\n\n  subgraph MECH [\&quot;MECHANICAL — no electrical link to the nodes\&quot;]\n    M1[\&quot;M1 · MACHINE&lt;br/&gt;fan/drill + a bolt on a blade (the load)\&quot;]\n    CONV[\&quot;CONVEYOR 100×350 mm&lt;br/&gt;own gearmotor + speed knob + own adapter&lt;br/&gt;NOT monitored\&quot;]\n  end\n\n  subgraph OPT [\&quot;OPTIONS — not in the base wiring\&quot;]\n    XS5[\&quot;XS5 · TCRT5000 #2&lt;br/&gt;belt-end sensor (optional)\&quot;]\n    INA[\&quot;INA226 (I2C option)&lt;br/&gt;no divider needed · not wired\&quot;]\n  end\n\n  CHK[\&quot;PRE-POWER CHECKLIST&lt;br/&gt;USB cables pass data (a charge-only won&#39;t flash)&lt;br/&gt;steady 5 V at BB2 rows 8/10 before plugging the servo&lt;br/&gt;inter-board bridges: GND on all 3 BBs · +3 V BB2→BB3&lt;br/&gt;divider tap ≈ 1.2–1.3 V (machine off)&lt;br/&gt;TCRT LEDs: quiet when empty, blink per part&lt;br/&gt;taken GPIOs: 0/3/45/46 · 19/20 · 35–37 · 43/44\&quot;]\n\n  HOST -. \&quot;USB-C #1 (data)\&quot; .-&gt; UA\n  HOST -. \&quot;USB-C #2\&quot; .-&gt; UQ\n  HOST -. \&quot;USB-C #3\&quot; .-&gt; UP\n\n  BT2 == \&quot;+12 V → IP+\&quot; ==&gt; XS1\n  XS1 == \&quot;IP− → M+\&quot; ==&gt; M1\n  M1 -. \&quot;− return\&quot; .-&gt; BT2\n\n  UA -- \&quot;5V pin\&quot; --&gt; P5A\n  P5A -- \&quot;VCC ← BB1 bottom + rail\&quot; --&gt; XS1\n  UQ -- \&quot;3V3\&quot; --&gt; P3\n  P3 -- \&quot;BB2 top + rail → VDD r1\&quot; --&gt; Z1\n  P3 -- \&quot;BB2→BB3 bridge → VCC r1\&quot; --&gt; Z4\n  BT1 -- \&quot;+\&quot; --&gt; P5S\n  P5S -- \&quot;red → BB2 r8\&quot; --&gt; Z2\n\n  UQ -- \&quot;SCK = GPIO12 → BB2 r4\&quot; --&gt; Z1\n  UQ -- \&quot;WS = GPIO13 → BB2 r5\&quot; --&gt; Z1\n  UQ -- \&quot;SD = GPIO14 → BB2 r3\&quot; --&gt; Z1\n  UQ -- \&quot;PWM 50 Hz · GPIO11 → BB2 r12\&quot; --&gt; Z2\n  Z2 -- \&quot;SIG (orange)\&quot; --&gt; M2\n  M2 -- \&quot;brown − → BB2 r10\&quot; --&gt; Z2\n\n  BT1 -- \&quot;− → common GND!\&quot; --&gt; GND\n  Z2 -- \&quot;GND BB2 r10 → − rail\&quot; --&gt; GND\n  Z1 -- \&quot;GND BB2 r2 · L/R→GND\&quot; --&gt; GND\n\n  XS1 -- \&quot;OUT (white) → BB1 r1\&quot; --&gt; R1\n  R1 -- \&quot;BB1 r2\&quot; --&gt; TAP\n  TAP -- \&quot;tap → GPIO4 (ADC1)\&quot; --&gt; UA\n  TAP -- \&quot;→ BB1 r3\&quot; --&gt; R2\n  R2 -- \&quot;BB1 r3 → − rail\&quot; --&gt; GND\n\n  Z4 -- \&quot;OUT BB3 r3 → GPIO5\&quot; --&gt; UP\n  Z4 -- \&quot;GND BB3 r2\&quot; --&gt; GND\n  UP --&gt; GND\n  UA --&gt; GND\n  UQ --&gt; GND\n\n  XS5 -. \&quot;OUT → one more free pin\&quot; .-&gt; UP\n  M1 -. \&quot;belt start · bolt imbalance\&quot; .- CONV\n  INA -. \&quot;I2C — not wired yet\&quot; .- XS1\n\n  classDef board fill:#e2e8f0,stroke:#475569,stroke-width:2px,color:#1f2937\n  classDef sensor fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a\n  classDef power fill:#f1f5f9,stroke:#64748b,stroke-width:2px,color:#1f2937\n  classDef res fill:#ffffff,stroke:#16a34a,stroke-width:2px,color:#14532d\n  classDef net fill:#ffffff,stroke:#111827,stroke-width:1.6px,color:#111827\n  classDef zone fill:#fefce8,stroke:#ca8a04,stroke-width:1.8px,color:#713f12\n  classDef mech fill:#f8fafc,stroke:#57534e,stroke-width:1.6px,stroke-dasharray:6 4,color:#57534e\n  classDef opt fill:#f8fafc,stroke:#94a3b8,stroke-width:1.4px,stroke-dasharray:4 3,color:#475569\n  classDef note fill:#f1f5f9,stroke:#64748b,stroke-width:1.4px,color:#334155\n\n  class HOST,UA,UQ,UP board\n  class XS1,M2 sensor\n  class BT1,BT2 power\n  class R1,R2 res\n  class GND,P3,P5A,P5S,TAP net\n  class Z1,Z2,Z4 zone\n  class M1,CONV mech\n  class XS5,INA opt\n  class CHK note&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pHWhnGjTSyzdKf-VjEO7-2">
